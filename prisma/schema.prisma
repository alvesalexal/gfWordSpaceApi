generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Class {
  id      Int       @id @default(autoincrement())
  name    String
  Bio     String?   @db.VarChar(150)
  Content Content[]
  Lecture Lecture[]
  Study   Study[]
}

model Comment {
  id            Int       @id @default(autoincrement())
  created_at    DateTime  @default(now())
  message       String
  fk_student_id Int?
  fk_content_id Int
  updated_at    DateTime?
  fk_teacher_id Int?
  Content       Content   @relation(fields: [fk_content_id], references: [id])
  Student       Student?  @relation(fields: [fk_student_id], references: [id])
  Teacher       Teacher?  @relation(fields: [fk_teacher_id], references: [id])
}

model Content {
  id            Int       @id @default(autoincrement())
  created_at    DateTime  @default(now())
  url           String?
  message       String
  title         String
  subTitle      String?
  observation   String?
  type          String    @default("tarefa")
  fk_class_id   Int
  fk_teacher_id Int
  Comment       Comment[]
  Class         Class     @relation(fields: [fk_class_id], references: [id])
  Teacher       Teacher   @relation(fields: [fk_teacher_id], references: [id])
  Test          Test[]
}

model Lecture {
  id            Int     @id @default(autoincrement())
  fk_teacher_id Int
  fk_class_id   Int
  Class         Class   @relation(fields: [fk_class_id], references: [id])
  Teacher       Teacher @relation(fields: [fk_teacher_id], references: [id])
}

model Performs {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  score         Decimal?
  answer        String?
  fk_student_id Int
  fk_test_id    Int
  Student       Student  @relation(fields: [fk_student_id], references: [id])
  Test          Test     @relation(fields: [fk_test_id], references: [id])
}

model Person {
  id         Int       @id @default(autoincrement())
  name       String
  username   String?   @unique
  phone      String?
  email      String
  password   String
  role       String    @default("student")
  url_avatar String?
  created_at DateTime  @default(now())
  Student    Student[]
  Teacher    Teacher[]
}

model Question {
  id             Int     @id @default(autoincrement())
  title          String
  type           String  @default("multiple_choice")
  options        String?
  correct_answer String?
  order          Int     @default(0)
  fk_test_id     Int
  Test           Test    @relation(fields: [fk_test_id], references: [id])
}

model Student {
  id           Int        @id @default(autoincrement())
  active       Boolean    @default(true)
  bio          String?
  fk_person_id Int
  Comment      Comment[]
  Performs     Performs[]
  Person       Person     @relation(fields: [fk_person_id], references: [id])
  Study        Study[]
}

model Study {
  id            Int     @id @default(autoincrement())
  fk_student_id Int
  fk_class_id   Int
  Class         Class   @relation(fields: [fk_class_id], references: [id])
  Student       Student @relation(fields: [fk_student_id], references: [id])
}

model Teacher {
  id           Int       @id @default(autoincrement())
  active       Boolean   @default(true)
  bio          String?
  fk_person_id Int
  Comment      Comment[]
  Content      Content[]
  Lecture      Lecture[]
  Person       Person    @relation(fields: [fk_person_id], references: [id])
}

model Test {
  id            Int        @id @default(autoincrement())
  title         String
  timer_minutes Int        @default(60)
  observation   String?
  created_at    DateTime   @default(now())
  fk_content_id Int
  Performs      Performs[]
  Question      Question[]
  Content       Content    @relation(fields: [fk_content_id], references: [id])
}
